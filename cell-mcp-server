#!/bin/bash
# Wrapper script for Cell CLI compatibility

# Handle --version flag
if [ "$1" == "--version" ]; then
    # Get the directory of this script to find the config
    DIR="$(cd "$(dirname "$0")" && pwd)"
    # Use python to extract the version from config.py and exit
    python -c "import sys; sys.path.append('$DIR'); from config import __version__; print(__version__)"
    exit 0
fi

# Get the directory of this script
DIR="$(cd "$(dirname "$0")" && pwd)"

# Change to the zen-mcp-server directory
cd "$DIR"

# User-specific development environment
export DISABLED_TOOLS="tracer"
export DEFAULT_MODEL="grok-code-fast"
export CONVERSATION_TIMEOUT_HOURS="8"
export MAX_CONVERSATION_TURNS="20"
export LOG_LEVEL="ERROR"

# Execute the Python server with all arguments passed through
exec .zen_venv/bin/python server.py "$@"